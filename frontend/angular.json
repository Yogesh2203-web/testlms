{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "institute-lms-ui": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/institute-lms-ui",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [{"glob": "**/*", "input": "public"}],
            "styles": ["src/styles.css"]
          },
          "configurations": {"production": {"optimization": true, "outputHashing": "all"}},
          "defaultConfiguration": "production"
        },
        "serve": {"builder": "@angular/build:dev-server", "configurations": {"development": {"buildTarget": "institute-lms-ui:build"}, "production": {"buildTarget": "institute-lms-ui:build:production"}}, "defaultConfiguration": "development"}
      }
    }
  }
}
